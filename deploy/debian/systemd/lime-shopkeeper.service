[Unit]
Description=LIME Shopkeeper (Go backend + Chromium accessibility scanner)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=lime
Group=lime
UMask=0077
WorkingDirectory=/opt/lime/shopkeeper
# EnvironmentFile must define DATABASE_URL and may define SHOPKEEPER_PORT,
# ACT_RULES_PATH, SHOPKEEPER_SCREENSHOT_DIR, and REPORT_BASE_URL.
EnvironmentFile=/etc/lime/shopkeeper.env
RuntimeDirectory=lime-shopkeeper
RuntimeDirectoryMode=0700
Environment=HOME=/run/lime-shopkeeper
Environment=XDG_CONFIG_HOME=/run/lime-shopkeeper/.config
Environment=XDG_CACHE_HOME=/run/lime-shopkeeper/.cache
ExecStart=/opt/lime/shopkeeper/shopkeeper
Restart=on-failure
RestartSec=5
# Chromium uses /tmp for profile data and writes screenshots to SHOPKEEPER_SCREENSHOT_DIR.
ReadWritePaths=/opt/lime/shopkeeper/screenshots
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
NoNewPrivileges=yes
MemoryAccounting=yes
MemoryMax=2G
MemorySwapMax=0
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
