LIME_IMAGE_REGISTRY=ghcr.io/sumanbasuli
LIME_IMAGE_TAG=v0.1.0
DATABASE_URL=postgresql://username:password@db-host:5432/lime_db?sslmode=disable
SHOPKEEPER_URL=http://shopkeeper:8080
# Add public DNS names while retaining the internal ui/shopkeeper aliases.
LIME_ALLOWED_HOSTS=ui,shopkeeper
LIME_SHOPKEEPER_MEMORY_LIMIT=2g
LIME_API_PORT=8080
LIME_UI_PORT=3000

# Check GitHub releases for updates and show eligible notices by default.
# Set to "false" to disable outbound checks (for example, in air-gapped setups).
LIME_UPDATE_CHECK=true
LIME_GITHUB_REPO=sumanbasuli/lime
