# Run `make init-env` for a fresh source stack. It writes matching private
# credentials below; this template cannot start source Compose as-is.
# Keep the resulting .env unchanged when updating an existing database volume.
POSTGRES_USER=lime
POSTGRES_PASSWORD=
POSTGRES_DB=lime_db

# App runtime configuration for native local development
DATABASE_URL=
SHOPKEEPER_URL=http://localhost:8080
# Add public DNS names here when serving LIME through a reverse proxy.
# Keep ui and shopkeeper so the two Docker services can reach each other.
LIME_ALLOWED_HOSTS=ui,shopkeeper
LIME_SHOPKEEPER_MEMORY_LIMIT=2g

# Shopkeeper
LIME_API_PORT=8080

# UI
LIME_UI_PORT=3000
# Enabled by default; set false to disable outbound GitHub release checks.
LIME_UPDATE_CHECK=true
